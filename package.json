{
  "name": "@knights-eye-chess/game-tree",
  "version": "0.1.0-dev.5",
  "private": true,
  "type": "module",
  "description": "Private optional structural chess tree and PGN preview",
  "files": [
    "dist",
    "src",
    "tests",
    "build.mjs",
    "README.md",
    "SOURCE-ORIGIN.json",
    "scripts",
    "LICENSE",
    "NOTICE",
    "LICENSING.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "NPM-PUBLISHING.md",
    "npm-release.json"
  ],
  "exports": {
    "./tree": {
      "types": "./dist/tree.d.ts",
      "import": "./dist/tree.js"
    },
    "./pgn": {
      "types": "./dist/pgn.d.ts",
      "import": "./dist/pgn.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "pack:checked": "npm run check && node scripts/pack.mjs",
    "pack:artifact": "node scripts/pack.mjs",
    "publish:verify": "node scripts/verify-release.mjs",
    "publish:prepare": "npm run pack:checked && npm run publish:verify"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knights-eye-chess/game-tree.git"
  },
  "license": "MIT"
}
